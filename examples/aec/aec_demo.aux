function result = aec_demo(seconds)
// Try r = aec_demo(60). Uses the current runtime sampling rate.
// Recommended: Sampling Rate = 8000 in Settings > View Runtime Settings.
fs = getfs()
if seconds < 10
    error("Use at least 10 seconds so all demonstration phases are present")
end
N = round(seconds * fs)
k = 1:N
t = (k - 1) / fs
// Deterministic broadband test excitation, generated once before processing.
// This is a synthetic identification probe, not a speech-quality benchmark.
q = abs(sin(k * 12.9898)) * 43758.5453
x = .25 * (2 * (q - floor(q)) - 1)
near = zeros(N)
// Two known double-talk intervals: 25-42% and 75-83% of the recording.
talk = zeros(N)
talk(round(.25*N)+1:round(.42*N)) = 1
talk(round(.75*N)+1:round(.83*N)) = 1
near = .12 * (sin(2*pi*233*t) + .4*sin(2*pi*467*t)) * talk
// Two room responses, both within the adaptive filter's 32 ms span.
M = round(.032 * fs)
h1 = zeros(M)
h1(round(.006*fs) + 1) = .65
h1(round(.013*fs) + 1) = -.28
h1(round(.023*fs) + 1) = .16
h2 = zeros(M)
h2(round(.009*fs) + 1) = .48
h2(round(.018*fs) + 1) = .32
h2(round(.027*fs) + 1) = -.19
echo = filt(x, h1)
echo2 = filt(x, h2)
change = round(.58 * N)
echo(change:N) = echo2(change:N)
mic = echo + near
// This oracle mask uses the simulation schedule, not a real double-talk detector.
adapt = 1 - talk
state.w = zeros(M)
state.u = zeros(M)
clean = zeros(N)
estimated = zeros(N)
chunk = round(.1 * fs)
for first = 1:chunk:N
    last = min([N first + chunk - 1])
    [e, y, state] = aec_nlms(x(first:last), mic(first:last), adapt(first:last), state, .5)
    clean(first:last) = e
    estimated(first:last) = y
end
// Ground truth is used ONLY for evaluation, never passed to the canceller.
// ERLE is reported only for full one-second windows without near-end speech.
count = floor(N / fs)
erle = zeros(count)
valid = zeros(count)
for b = 1:count
    first = (b - 1)*fs + 1
    last = b*fs
    if sum(talk(first:last)) == 0
        residual = clean(first:last)
        original = echo(first:last)
        erle(b) = 10*log10((sum(original*original) + 1e-20) / (sum(residual*residual) + 1e-20))
        valid(b) = 1
    end
end
result.reference = audio(x)
result.microphone = audio(mic)
result.near = audio(near)
result.echo = audio(echo)
result.clean = audio(clean)
result.estimated = audio(estimated)
result.erle_db = erle
result.erle_valid = valid
result.weights = state.w
result.room_final = h2
result.fs = fs
result.path_change_seconds = (change - 1) / fs

