function out = aec_progress_block(chunk, timestamp, prior, first, microphone, adapt, taps, mu)
// progblocks passes contiguous reference audio; align the other inputs by sample.
if first
    out.state.w = zeros(taps)
    out.state.u = zeros(taps)
    out.clean = []
    out.estimated = []
    out.samples = 0
else
    out = prior
end
start = out.samples + 1
last = out.samples + length(chunk)
[e, y, state] = aec_nlms(vector(chunk), microphone(start:last), adapt(start:last), out.state, mu)
out.clean ++= e
out.estimated ++= y
out.state = state
out.samples = last
out.last_block_ms = timestamp
